    { title: "Como criar um site estilo YouTube", channel: "Coding Lab", views: "10 mil visualizações", time: "há 5 horas", thumb: "https://picsum.photos/seed/3/300/200" },
    { title: "O guia do JavaScript Moderno", channel: "Web Master", views: "80 mil visualizações", time: "há 3 dias", thumb: "https://picsum.photos/seed/4/300/200" },
    { title: "Viagem ao Japão: Vlog", channel: "Traveler", views: "1.2 mi visualizações", time: "há 1 mês", thumb: "https://picsum.photos/seed/5/300/200" },
