* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Roboto, Arial, sans-serif;
}

body {
    background-color: #0f0f0f;
    color: white;
}

.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    height: 56px;
    background: #0f0f0f;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    z-index: 100;
}

.nav-left, .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
}

.nav-left img {
    width: 90px;
    cursor: pointer;
}

.nav-center {
    display: flex;
    align-items: center;
    flex: 0 1 720px;
}

.search-bar {
    display: flex;
    width: 100%;
    background: #121212;
    border: 1px solid #303030;
    border-radius: 40px 0 0 40px;
    padding-left: 15px;
    margin-left: 40px;
}

.search-bar input {
    width: 100%;
    background: transparent;
    border: none;
    color: white;
    font-size: 16px;
    padding: 8px 10px;
}

.search-bar button {
    background: #222222;
    border: 1px solid #303030;
    border-radius: 0 40px 40px 0;
    padding: 0 20px;
    cursor: pointer;
    color: white;
}

.user-avatar {
    width: 32px;
    height: 32px;
    background: #717171;
    border-radius: 50%;
}

.main-container {
    display: flex;
    margin-top: 56px;
}

.sidebar {
    width: 240px;
    height: calc(100vh - 56px);
    position: sticky;
    top: 56px;
    padding: 12px;
}

.nav-link {
    display: flex;
    align-items: center;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
}

.nav-link:hover, .nav-link.active {
    background: #272727;
}

.nav-link i { margin-right: 20px; }

.content {
    flex: 1;
    padding: 20px;
}

.categories {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    overflow-x: auto;
}

.category-chip {
    background: #272727;
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
}

.category-chip.active {
    background: white;
    color: black;
}

.video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
}

.video-card {
    cursor: pointer;
}

.thumbnail {
    width: 100%;
    aspect-ratio: 16/9;
    background: #333;
    border-radius: 12px;
    object-fit: cover;
}

.video-info {
    display: flex;
    margin-top: 12px;
    gap: 12px;
}

.channel-icon {
    width: 36px;
    height: 36px;
    background: #444;
    border-radius: 50%;
    flex-shrink: 0;
}

.details h3 {
    font-size: 14px;
    margin-bottom: 4px;
}

.details p {
    font-size: 12px;
    color: #aaa;
}
